# Server only. Never prefix secrets with VITE_.
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/brain-vat.sqlite
# Comma-separated exact browser and extension origins. No wildcard origins.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8787
# Keep registration invitation-only after the first account.
REGISTRATION_OPEN=false
# Optional public server origin baked into extension builds (not a secret).
# VITE_API_URL=https://your-brain-vat.example
