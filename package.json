{
  "name": "brain-vat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "minimatch@10.2.6": "11.0.1"
    }
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "setup:lean": "node scripts/setup-lean.mjs",
    "test:lean": "vitest run --config tests/lean/vitest.config.ts",
    "dev": "pnpm prepare:assets && vite --host 127.0.0.1",
    "dev:server": "tsx watch --env-file-if-exists=.env server/main.ts",
    "dev:all": "concurrently -k 'pnpm dev' 'pnpm dev:server'",
    "start": "tsx --env-file-if-exists=.env server/main.ts",
    "backup": "tsx --env-file-if-exists=.env server/backup.ts",
    "package:extension": "pnpm build:extension && node scripts/package-extension.mjs",
    "dev:extension": "pnpm prepare:assets && wxt",
    "build:web": "pnpm prepare:assets && vite build",
    "build:extension": "pnpm prepare:assets && wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "playwright test --config playwright.firefox.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-width.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "idb": "8.0.4",
    "lucide-react": "1.70.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
